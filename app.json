{
  "expo": {
    "name": "notes-app",
    "slug": "notes-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "notesapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to your camera to take photos for your notes.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to attach existing photos to your notes.",
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to help organize your notes by location and find nearby notes.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to your location to help organize your notes by location and find nearby notes.",
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to record voice memos for your notes."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyA5EwWICbPAzb8c6FX1N0BoSvpZrscC-Nw"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ],
      "package": "com.anonymous.notesapp",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA5EwWICbPAzb8c6FX1N0BoSvpZrscC-Nw"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      "expo-media-library",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "notes-app-project"
      }
    }
  }
}
